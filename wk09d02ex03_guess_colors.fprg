<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="codingsteps"/>
        <attribute name="authors" value="USER"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-28 05:44:10 PM"/>
        <attribute name="created" value="VVNFUjtERVNLVE9QLUNFVVJQOTM7MjAyNi0wOS0xMTsxMDozMDoyOCBQTTsyNjcy"/>
        <attribute name="edited" value="VVNFUjtERVNLVE9QLUNFVVJQOTM7MjAyNi0wOS0yODswNTo0NDoxMCBQTTszOzI3OTA="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="rainbowColor" type="String" array="True" size="7"/>
            <declare name="userGuesses" type="String" array="True" size="7"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="correctCount" type="Integer" array="False" size=""/>
            <assign variable="rainbowColor[0]" expression="&quot;red&quot;"/>
            <assign variable="rainbowColor[1]" expression="&quot;orange&quot;"/>
            <assign variable="rainbowColor[2]" expression="&quot;yellow&quot;"/>
            <assign variable="rainbowColor[3]" expression="&quot;green&quot;"/>
            <assign variable="rainbowColor[4]" expression="&quot;blue&quot;"/>
            <assign variable="rainbowColor[5]" expression="&quot;indigo&quot;"/>
            <assign variable="rainbowColor[6]" expression="&quot;violet&quot;"/>
            <for variable="i" start="0" end="6" direction="inc" step="1">
                <output expression="&quot;Enter the colors of the rainbow &quot; &amp; (i + 1) &amp; &quot;:&quot;" newline="True"/>
                <input variable="userGuesses[i]"/>
                <assign variable="correctCount" expression="0"/>
            </for>
            <for variable="i" start="0" end="6" direction="inc" step="1">
                <if expression="userGuesses[i] == rainbowColor[i]">
                    <then>
                        <assign variable="correctCount" expression="correctCount + 1"/>
                    </then>
                    <else/>
                </if>
            </for>
            <output expression="&quot;You got &quot; &amp; correctCount &amp; &quot; correct answers.&quot;" newline="True"/>
            <if expression="correctCount &gt;= 6">
                <then>
                    <output expression="&quot;Grade: excellent&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="correctCount &gt;= 3">
                        <then>
                            <output expression="&quot;Grade: average&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Grade: poor&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
